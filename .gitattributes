# Normalize line endings: LF in the repository, platform-appropriate on checkout.
# This removes phantom CRLF/LF diffs between Windows and Unix environments.
* text=auto

# Explicit text types (LF in repo)
*.py text
*.md text
*.json text
*.jsonc text
*.yaml text
*.yml text
*.toml text
*.txt text
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary types: never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.7z binary
*.lance binary

# Golden HTML snapshots are compared byte for byte: keep LF everywhere.
tests/fixtures/golden/**/*.html text eol=lf

# Generated by `python -m sentinel.adapters --plugin` (IMP-279): collapsed in diffs.
plugins/** linguist-generated=true
.claude-plugin/marketplace.json linguist-generated=true

# Shell scripts run under sh/bash; CRLF would break them on a Windows checkout (IMP-290).
*.sh text eol=lf
