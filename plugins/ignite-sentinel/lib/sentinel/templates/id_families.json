{
  "version": 1,
  "families": {
    "GAP": {"status": "kept", "pattern": "GAP-[A-Z0-9]+(?:-[A-Z0-9]+)*", "example": "GAP-OBJECTIVE", "owner": "discovery", "description": "Discovery gap; global across releases (one workspace per series)."},
    "ASM": {"status": "kept", "pattern": "ASM-[A-Z0-9]+(?:-[A-Z0-9]+)*", "example": "ASM-QUEUE", "owner": "assumptions", "description": "Recorded assumption."},
    "DEC": {"status": "kept", "pattern": "DEC-[A-Z0-9]+(?:-[A-Z0-9]+)*", "example": "DEC-001", "owner": "decisions", "description": "Decision. Graph nodes are DEC-NNN; /self-review decisions take a named suffix (DEC-AUTH-TOKEN)."},
    "US": {"status": "kept", "pattern": "US-[0-9]{3}", "example": "US-001", "owner": "backlog", "description": "User story in the generated backlog."},
    "SPEC-U": {"status": "kept", "pattern": "SPEC-U-[0-9]{3}", "example": "SPEC-U-001", "owner": "specs", "description": "Spec unit."},
    "CTX": {"status": "kept", "pattern": "CTX-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*", "example": "CTX-001", "owner": "context_request", "description": "Context request to a domain owner."},
    "RU": {"status": "kept", "pattern": "RU-[0-9]{3}", "example": "RU-001", "owner": "discovery", "description": "Requirement unit."},
    "REQ": {"status": "kept", "pattern": "REQ-(?:EARS-)?[0-9]{3}", "example": "REQ-EARS-001", "owner": "requirements", "description": "Requirement; REQ-EARS-NNN once normalized to EARS."},
    "AC": {"status": "kept", "pattern": "AC-[0-9]{3}(?:-[0-9]{2})?", "example": "AC-001-01", "owner": "backlog", "description": "Acceptance criterion of a v1 story."},
    "F": {"status": "kept", "pattern": "F-[0-9]{2,}", "example": "F-01", "owner": "source_registry", "description": "Governed source row (IMP-250a)."},
    "D": {"status": "view", "view_of": "DEC", "pattern": "D-[0-9]+\\.[0-9]+", "example": "D-2.1", "owner": "decisions", "description": "Numbered view of a DEC inside a v2 artifact; never a family of its own (decisions.py already holds reversibility, consequences, options and supersedes)."},
    "RN": {"status": "new", "pattern": "RN-[0-9]{2,3}", "example": "RN-04", "release_prefix": true, "home": "2.2", "description": "Business rule (brief v2 2.2)."},
    "CA": {"status": "new", "pattern": "CA-[0-9]{2,3}(?:\\.[0-9]+)?", "example": "CA-03", "release_prefix": true, "home": "1.5", "description": "Acceptance criterion with test data and result (brief v2 1.5)."},
    "HU": {"status": "new", "pattern": "HU-[0-9]{2,3}", "example": "HU-07", "release_prefix": true, "description": "User story of brief v2; specified by SPEC-U and sliced into US."},
    "SC": {"status": "new", "pattern": "SC-[0-9]{2,3}", "example": "SC-01", "home": "1.3", "description": "Success metric with formula, baseline and target (brief v2 1.3)."},
    "I": {"status": "new", "pattern": "I-[0-9]+", "example": "I-2", "home": "9", "description": "Item that a section 9 topic depends on (`I-n | ninguna`)."},
    "P": {"status": "new", "pattern": "P-[0-9]+", "example": "P-3", "description": "Screen."},
    "E": {"status": "new", "pattern": "E-[0-9]+\\.[0-9]+", "example": "E-1.2", "description": "Epic, numbered by release and order."},
    "C": {"status": "new", "pattern": "C-[0-9]{2,}", "example": "C-04", "home": "9", "description": "Section 9 item."},
    "R": {"status": "new", "pattern": "R-[0-9]+", "example": "R-2", "home": "2.1", "description": "Role."},
    "PDef": {"status": "new", "pattern": "PDef-[0-9]+", "example": "PDef-1", "description": "Product definition entry; its content is settled by brief v2 (IMP-252)."}
  },
  "release_prefix": {"pattern": "r(?P<release>[0-9]+)-", "example": "r2-RN-04", "families": ["RN", "CA", "HU"]},
  "edges": [
    {"from": "HU", "to": "SPEC-U", "type": "specified_by"},
    {"from": "SPEC-U", "to": "US", "type": "sliced_into"}
  ],
  "catalog_keys": {
    "error_code": {"pattern": "ERR_[A-Z0-9]+(?:_[A-Z0-9]+)*", "example": "ERR_PAYMENT_DECLINED"},
    "event": {"pattern": "evt\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)+", "example": "evt.invoice.approved"},
    "flag": {"pattern": "ff\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*", "example": "ff.double_signature"},
    "route": {"pattern": "/[a-z0-9_{}/-]*", "example": "/invoices/{id}/approve"}
  },
  "graph_node_prefixes": ["RAW", "REQ", "GAP", "DEC", "SEED", "DISC", "PRD", "SPEC", "EPIC", "US", "AC", "TC", "QA", "CHG", "EV", "CTX"],
  "graph_upserted_families": ["RU", "SPEC-U", "REQ", "GAP"],
  "citation_documents": {
    "brief": "02_requirements/project-brief.md",
    "requirements": "02_requirements/requirements.md",
    "prd": "03_specs/prd.md",
    "specs": "03_specs/specs.md",
    "gaps": "01_discovery/gaps.md",
    "decisions": "01_discovery/decisions.md",
    "assumptions": "01_discovery/assumptions.md"
  },
  "v2_marker": "<!-- sentinel-artifact: v2 -->",
  "retired_ids_file": "06_traceability/retired_ids.json"
}
