{
  // Ignite Sentinel repo-local Kilo Code configuration.
  //
  // IMP-235 (H12): this file used to carry a top-level `permissions` block with
  // `file.read` / `file.write` / `file.deny` arrays and a `commands.allow` list.
  // Kilo never read any of it: its config is the opencode lineage (the extension
  // declares SCHEMA = https://app.kilo.ai/config.json) and rejected the whole
  // block with `Unrecognized key: permissions`. The real key is `permission`
  // (singular) and its value is a map of pattern -> "allow" | "ask" | "deny" per
  // tool. The `$schema` line below is what makes the editor validate this file,
  // so a shape error surfaces immediately instead of staying silent for weeks.
  //
  // Scope on purpose: only what PROTECTS is declared here. The old read
  // allowlist is not ported — it restricted nothing in practice (Kilo allows
  // reads by default) and reinstating it would only add prompts. Governed
  // artifacts are what must stay protected, mirroring the Claude PreToolUse hook
  // and the Codex pre-tool-use policy.
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    // Governed artifacts are regenerated only through their owning command
    // (/brief, /specs, /backlog), never hand-edited. Kilo's editor must not
    // write them; the CLI still regenerates them (see `bash` below). The
    // catch-all comes first and the exceptions after, which is the ordering
    // Kilo's own built-in presets use.
    "edit": {
      "*": "allow",
      "workspaces/*/02_requirements/project-brief.md": "deny",
      "workspaces/*/03_specs/*.md": "deny",
      "workspaces/*/04_backlog/*.md": "deny",
      ".git/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*secret*": "deny",
      "**/*token*": "deny",
      "dist/**": "deny",
      "build/**": "deny"
    },
    // Reads stay open (that is Kilo's default anyway); only local secrets are
    // held back. Skills and their `references/*.md` layer load from
    // `.agents/skills/` without any entry here.
    "read": {
      "*": "allow",
      "**/.env": "ask",
      "**/.env.*": "ask",
      "**/*secret*": "ask",
      "**/*token*": "ask"
    },
    // Pre-authorize the Sentinel CLI so the BA is not prompted for every
    // lifecycle command. No catch-all is declared: anything not listed falls to
    // Kilo's own default rather than to a stricter rule invented here.
    "bash": {
      "python -m sentinel *": "allow",
      "python -m sentinel.adapters": "allow",
      "python -m unittest discover -s tests": "allow",
      "powershell -ExecutionPolicy Bypass -File installers/sentinel.ps1 *": "allow",
      "pwsh -ExecutionPolicy Bypass -File installers/sentinel.ps1 *": "allow",
      "sh installers/sentinel.sh *": "allow"
    }
  }
}
